datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  businessName    String
  businessType    String?
  phoneNumber     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clients         Client[]
  campaigns       Campaign[]
  automationFlows AutomationFlow[]
  reports         Report[]
}

model Client {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  email          String?
  name           String?
  phone          String?
  status         String          @default("active")
  tags           String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  campaignEvents CampaignEvent[]
}

model Campaign {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  name           String
  goal           String?
  channels       String[]
  startDate      DateTime?
  endDate        DateTime?
  status         String          @default("draft")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialPosts    SocialPost[]
  emails         Email[]
  campaignEvents CampaignEvent[]
}

model SocialPost {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  platform    String
  contentText String
  mediaUrl    String?
  scheduledAt DateTime
  postedAt    DateTime?
  status      String    @default("scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Email {
  id           String   @id @default(uuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  subject      String
  body         String
  recipientEmail String
  sentAt       DateTime?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AutomationFlow {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  name        String
  description String?
  isActive    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  triggers    AutomationTrigger[]
  actions     AutomationAction[]
}

model AutomationTrigger {
  id        String           @id @default(uuid())
  flowId    String
  flow      AutomationFlow   @relation(fields: [flowId], references: [id])
  type      String
  config    Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AutomationAction {
  id           String         @id @default(uuid())
  flowId       String
  flow         AutomationFlow @relation(fields: [flowId], references: [id])
  type         String
  config       Json
  order        Int
  delayMinutes Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Report {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  type        String
  data        Json
  generatedAt DateTime  @default(now())
  sentAt      DateTime?
  status      String    @default("generated")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CampaignEvent {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])
  type       String
  details    Json?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
