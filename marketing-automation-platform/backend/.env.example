# Environment variables for backend
DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_TIME=3600s
PORT=3000

# OpenAI API Key
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_PLACEHOLDER

# Twilio (for WhatsApp, SMS - currently simulated)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_PLACEHOLDER
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_PLACEHOLDER
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886 # Example Twilio sandbox number

# Meta (Facebook, Instagram - OAuth2 flow not implemented yet)
META_APP_ID=YOUR_META_APP_ID_PLACEHOLDER
META_APP_SECRET=YOUR_META_APP_SECRET_PLACEHOLDER

# Google (Gmail API - OAuth2 flow not implemented yet)
GMAIL_CLIENT_ID=YOUR_GMAIL_CLIENT_ID_PLACEHOLDER
GMAIL_CLIENT_SECRET=YOUR_GMAIL_CLIENT_SECRET_PLACEHOLDER
GMAIL_REDIRECT_URI=YOUR_GMAIL_REDIRECT_URI_PLACEHOLDER # e.g., http://localhost:3000/auth/google/callback

# Email Providers (Transactional)
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_PLACEHOLDER
MAILCHIMP_API_KEY=YOUR_MAILCHIMP_API_KEY_PLACEHOLDER
